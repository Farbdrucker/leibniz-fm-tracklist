# Copy to .env and fill in. Never commit the real .env file.

# Domain pointed (A/AAAA record) at this server's public IP. Caddy uses it to
# request and auto-renew a Let's Encrypt HTTPS certificate - ports 80+443
# must be reachable from the internet for the initial challenge to succeed.
DOMAIN=tracklist.example.com

# Get a client id/secret by creating an app at https://developer.spotify.com/dashboard.
# Get a refresh token by running: python scripts/spotify_login.py
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: adds label, format, tracklist and videos to the song pages. Register
# an app at https://www.discogs.com/settings/developers (key + secret suffice,
# no OAuth login needed). Without it, MusicBrainz and Wikidata are still used.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
